import Foundation
@ main 
struct restaurantbillCalculatore{
  static func main(){

let itemPrice = 450.0
let quantity = 3
let subtotal = itemPrice * Double(quantity)          

let hasCoupon = true
let discountRate = (hasCoupon && subtotal > 1000) ? 0.10 : 0.0
let discount = subtotal * discountRate              
let discountedAmount = subtotal - discount           

let gst = discountedAmount * 0.18                    
let total = discountedAmount + gst                 

let people = 4
let share = total / Double(people)                  

print("Subtotal: ₹\(subtotal)")
print("Discount: ₹\(discount)")
print("GST: ₹\(gst)")
print("Total: ₹\(total)")
print("Each person pays: ₹\(String(format: "%.2f", share))")

let amount = 1234
let hundreds = amount / 100       
let remainder = amount % 100      // 34
print("₹\(amount) = \(hundreds) hundreds + ₹\(remainder)")
}
}
