
import Foundation

let swiftClub: Set<String> = ["Anu", "Ben", "Chitra", "Dev"]
let uiClub: Set<String> = ["Chitra", "Dev", "Esha"]

// (a) Members in both clubs
let bothClubs = swiftClub.intersection(uiClub)
print("Members in both clubs:", bothClubs.sorted())

// (b) Members only in the Swift club
let onlySwift = swiftClub.subtracting(uiClub)
print("Only in Swift club:", onlySwift.sorted())

// (c) Everyone in either club
let everyone = swiftClub.union(uiClub)
print("All members:", everyone.sorted())

// (d) Members in exactly one club
let exactlyOne = swiftClub.symmetricDifference(uiClub)
print("Members in exactly one club:", exactlyOne.sorted())

// Remove duplicates while preserving original order
let numbers = [3, 1, 3, 2, 1, 4]
var seen = Set<Int>()
var uniqueNumbers: [Int] = []

for number in numbers {
    if seen.insert(number).inserted {
        uniqueNumbers.append(number)
    }
}

print("Original numbers:", numbers)
print("After removing duplicates:", uniqueNumbers)
